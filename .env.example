# Azure AI Foundry (solo pruebas locales - no subir claves a git)
# Endpoint del recurso. Ejemplos:
#   Azure OpenAI v1 (recomendado): https://mi-recurso.openai.azure.com/openai/v1
#   Azure OpenAI clásico         : https://mi-recurso.openai.azure.com
#   Foundry Models               : https://mi-recurso.services.ai.azure.com/models
VITE_AZURE_FOUNDRY_ENDPOINT=

# Clave del recurso (Azure OpenAI > "API Keys" o Foundry > "Credentials")
VITE_AZURE_FOUNDRY_API_KEY=

# Nombre del deployment del modelo (p. ej. gpt-5.1)
VITE_AZURE_DEPLOYMENT_NAME=

# Versión de la API REST: "v1" para el endpoint /openai/v1,
# o una fecha para el clásico (p. ej. 2024-10-21, 2025-01-01-preview)
VITE_AZURE_API_VERSION=v1
