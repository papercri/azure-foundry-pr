# Azure AI Foundry · Agent Playground (solo pruebas locales - no subir claves a git)
# URL de invocación del agente (Foundry > agente > "Test" > copiar endpoint).
# Cambia cada vez que recreas el agente: termina en .../endpoint/protocols/openai/responses
#   p. ej. https://mi-recurso.services.ai.azure.com/api/projects/mi-proj/agents/mi-agente/endpoint/protocols/openai/responses
VITE_AZURE_FOUNDRY_AGENT_ENDPOINT=

# Clave del recurso (Foundry > "Credentials"). Si es un token AAD (JWT) se envía
# automáticamente como Authorization: Bearer en lugar de api-key.
VITE_AZURE_FOUNDRY_API_KEY=

# Versión de la API (query ?api-version=); "v1" es lo habitual. Opcional si la URL ya la trae.
VITE_AZURE_API_VERSION=v1

# Opcional: modelo a declarar en el body (solo si el agente lo exige)
# VITE_AZURE_DEPLOYMENT_NAME=
